# ── Django ────────────────────────────────────────────────────
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False   # 개발 환경에서만 True로 설정하세요
ALLOWED_HOSTS=localhost,127.0.0.1
# Cloudflare Tunnel 등 리버스 프록시로 배포 시, 프록시 도메인을 https:// 포함하여 설정 (쉼표로 여러 개 가능)
CSRF_TRUSTED_ORIGINS=

# ── 관리자 계정 (컨테이너 시작 시 자동 생성) ──────────────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin1234
DJANGO_SUPERUSER_EMAIL=admin@readme.local

# ── PostgreSQL (Docker Compose 서비스명: db) ──────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=

# NVIDIA NIM (LLM) ───────────────────────
NVIDIA_NIM_BASE_URL=
NVIDIA_LLM_MODEL=
NVIDIA_EMBEDDING_MODEL=
NVIDIA_API_KEY=

# ── LangSmith ─────────────────────────────────────────────────
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=

# ── FastAPI 내부 URL (docker-compose 서비스명) ────────────────
MODEL_SERVER_URL=http://fastapi_server:8001

# ── 추천 임계값 ───────────────────────────────────────────────
RECOMMENDATION_THRESHOLD=0.5

# ── JWT 인증 ──────────────────────────────────────────────────
JWT_SECRET_KEY=                         # 필수: 미설정 시 시작 경고 발생 (프로덕션에서는 반드시 별도 설정)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60    # Access token 유효 시간(분)
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7       # Refresh token 유효 시간(일)
JWT_IDLE_TIMEOUT_MINUTES=30             # 유휴 자동 로그아웃 시간(분)